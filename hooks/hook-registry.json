{
  "version": "1.0",
  "hooks": [
    {
      "id": "secret-detection",
      "tier": 1,
      "trigger": "PreToolUse",
      "matcher": ["Edit", "Write"],
      "script": "hooks/tier1/secret-detection.sh",
      "description": "Blocks edits introducing secrets"
    },
    {
      "id": "large-file-warning",
      "tier": 1,
      "trigger": "PreToolUse",
      "matcher": ["Edit"],
      "script": "hooks/tier1/large-file-warning.sh",
      "description": "Warns when editing files >500 lines"
    },
    {
      "id": "missing-test-companion",
      "tier": 1,
      "trigger": "PostToolUse",
      "matcher": ["Write"],
      "script": "hooks/tier1/missing-test-companion.sh",
      "description": "Suggests test file for new source files"
    },
    {
      "id": "dangerous-git-ops",
      "tier": 1,
      "trigger": "PreToolUse",
      "matcher": [
        "Bash(git push --force*)",
        "Bash(git push -f *)",
        "Bash(git reset --hard*)",
        "Bash(git checkout .)"
      ],
      "script": "hooks/tier1/dangerous-git-ops.sh",
      "description": "Blocks dangerous git commands"
    },
    {
      "id": "uncommitted-work-guard",
      "tier": 1,
      "trigger": "PreToolUse",
      "matcher": ["Bash(git checkout *)"],
      "script": "hooks/tier1/uncommitted-work-guard.sh",
      "description": "Warns on branch switch with uncommitted changes"
    },
    {
      "id": "build-before-commit",
      "tier": 1,
      "trigger": "PreToolUse",
      "matcher": ["Bash(git commit*)"],
      "script": "hooks/tier1/build-before-commit.sh",
      "description": "Runs lint/typecheck before commit"
    },
    {
      "id": "todo-cleanup",
      "tier": 1,
      "trigger": "PostToolUse",
      "matcher": ["Bash(git commit*)"],
      "script": "hooks/tier1/todo-cleanup.sh",
      "description": "Surfaces TODO/FIXME/HACK after commit"
    },
    {
      "id": "session-context-loader",
      "tier": 1,
      "trigger": "SessionStart",
      "matcher": null,
      "script": "hooks/tier1/session-context-loader.sh",
      "description": "Loads context + handoff on start"
    },
    {
      "id": "pre-compaction-backup",
      "tier": 1,
      "trigger": "PreCompact",
      "matcher": null,
      "script": "hooks/tier1/pre-compaction-backup.sh",
      "description": "Saves transcript before compression"
    },
    {
      "id": "worktree-cleanup",
      "tier": 1,
      "trigger": "SessionStart",
      "matcher": null,
      "script": "hooks/tier1/worktree-cleanup.sh",
      "description": "Cleans stale worktrees"
    },
    {
      "id": "failure-catalog-push",
      "tier": 1,
      "trigger": "manual",
      "matcher": null,
      "script": "hooks/tier1/failure-catalog-push.sh",
      "description": "Commit and push failure catalog after novel failure resolution"
    },
    {
      "id": "lint-on-save-python",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Edit(*.py)"],
      "script": "hooks/tier2/lint-on-save-python.sh",
      "description": "Runs Python linter on save",
      "stack_tags": ["ruff", "flake8"]
    },
    {
      "id": "lint-on-save-js",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Edit(*.js)", "Edit(*.ts)", "Edit(*.jsx)", "Edit(*.tsx)"],
      "script": "hooks/tier2/lint-on-save-js.sh",
      "description": "Runs ESLint on save",
      "stack_tags": ["eslint"]
    },
    {
      "id": "test-on-save-python",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Edit(app/**/*.py)", "Edit(src/**/*.py)"],
      "script": "hooks/tier2/test-on-save-python.sh",
      "description": "Runs pytest on save",
      "stack_tags": ["pytest"]
    },
    {
      "id": "test-on-save-js",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Edit(src/**/*.js)", "Edit(src/**/*.ts)", "Edit(src/**/*.tsx)"],
      "script": "hooks/tier2/test-on-save-js.sh",
      "description": "Runs Jest on save",
      "stack_tags": ["jest"]
    },
    {
      "id": "migration-sequence-check",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Write(alembic/versions/*.py)", "Write(**/migrations/*.py)"],
      "script": "hooks/tier2/migration-sequence-check.sh",
      "description": "Checks Alembic migration sequence on new migration file",
      "stack_tags": ["alembic"]
    },
    {
      "id": "type-check-on-save",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Edit(*.ts)", "Edit(*.tsx)"],
      "script": "hooks/tier2/type-check-on-save.sh",
      "description": "Runs TypeScript type check on save",
      "stack_tags": ["typescript"]
    },
    {
      "id": "docker-rebuild-reminder",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Edit(Dockerfile*)", "Edit(docker-compose*)"],
      "script": "hooks/tier2/docker-rebuild-reminder.sh",
      "description": "Reminds to rebuild Docker image after config changes",
      "stack_tags": ["docker"]
    },
    {
      "id": "decision-journal",
      "tier": 1,
      "trigger": "PostToolUse",
      "matcher": ["Edit", "Write"],
      "script": "hooks/tier1/decision-journal.sh",
      "description": "Periodic reminder to journal design decisions to .claude/session-log.md"
    },
    {
      "id": "gotcha-detector",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Edit(*.py)", "Edit(*.js)", "Edit(*.ts)", "Edit(*.css)", "Edit(*.html)"],
      "script": "hooks/tier2/gotcha-detector.sh",
      "description": "Detects known gotcha anti-patterns in edited files (data-driven from gotcha-rules.json)",
      "stack_tags": ["python", "javascript", "typescript", "css", "html"]
    },
    {
      "id": "context-rot-detection",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Read", "Edit", "Write", "Grep", "Glob"],
      "script": "hooks/tier2/context-rot-detection.sh",
      "description": "Warns when session touches too many files without compaction or summary",
      "stack_tags": ["python", "ruff", "flake8", "pytest", "node", "eslint", "jest", "typescript", "alembic", "docker"]
    },
    {
      "id": "stale-tool-output",
      "tier": 2,
      "trigger": "PostToolUse",
      "matcher": ["Read", "Grep", "Glob"],
      "script": "hooks/tier2/stale-tool-output.sh",
      "description": "Warns when Read/Grep/Glob operation count suggests stale duplicate tool results are dominating context (complements context-rot-detection which counts unique files)",
      "stack_tags": ["python", "ruff", "flake8", "pytest", "node", "eslint", "jest", "typescript", "alembic", "docker"]
    },
    {
      "id": "phase-gate",
      "tier": 1,
      "trigger": "PreToolUse",
      "matcher": ["Edit", "Write"],
      "script": "hooks/tier1/phase-gate.sh",
      "description": "Blocks source file edits outside Phase 5 (Implementation)"
    },
    {
      "id": "validate-phase-output",
      "tier": 1,
      "trigger": "PostToolUse",
      "matcher": ["Write(.claude/workflow-state.json)"],
      "script": "hooks/tier1/validate-phase-output.sh",
      "description": "Validates phase output artifacts against JSON schemas"
    },
    {
      "id": "metronome",
      "tier": 1,
      "trigger": "PreToolUse",
      "matcher": ["Bash"],
      "script": "hooks/tier1/metronome.py",
      "description": "Detects shortcut-taking language and blocks Bash to enforce step-by-step execution"
    },
    {
      "id": "quality-gate-on-stop",
      "tier": 2,
      "trigger": "Stop",
      "matcher": null,
      "script": "hooks/tier2/quality-gate-on-stop.sh",
      "description": "On Stop, runs the project quality gate (quick_ci.sh, npm test, pytest, cargo check, go build) and blocks turn-end if it fails so Claude can fix in-session. Auto-detects command; graceful no-op if none configured. Opt-in: activates only when a command is resolvable or .claude/quality-gate.json exists.",
      "stack_tags": ["pytest", "jest", "npm", "cargo", "go", "quick_ci"],
      "opt_in": true,
      "config": {
        "env": {
          "CLAUDE_QUALITY_GATE_CMD": "Override command (takes precedence over auto-detection)",
          "CLAUDE_QUALITY_GATE_TIMEOUT": "Seconds before timeout (default 120, does not block on timeout)",
          "CLAUDE_QUALITY_GATE_DISABLED": "Set to 1 to disable without removing hook registration"
        },
        "project_config": ".claude/quality-gate.json with {\"command\": \"...\"}"
      }
    },
    {
      "id": "pre-edit-lint-gate-python",
      "tier": 2,
      "trigger": "PreToolUse",
      "matcher": ["Edit", "Write"],
      "script": "hooks/tier2/pre-edit-lint-gate-python.sh",
      "stack_tags": ["python+ruff"],
      "opt_in": true,
      "description": "Blocks Edit/Write on *.py when the resulting content fails `ruff check` — forces fix-before-move-on. Skips when ruff is not installed."
    },
    {
      "id": "pre-edit-lint-gate-js",
      "tier": 2,
      "trigger": "PreToolUse",
      "matcher": ["Edit", "Write"],
      "script": "hooks/tier2/pre-edit-lint-gate-js.sh",
      "stack_tags": ["js+eslint", "ts+eslint"],
      "opt_in": true,
      "description": "Blocks Edit/Write on *.js/*.jsx/*.ts/*.tsx when the resulting content fails `eslint`. Skips when eslint is not installed."
    }
  ]
}
