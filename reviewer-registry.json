{
  "version": "1.1",
  "description": "Declarative reviewer selection for Phase 6. 'always' reviewers run every time. 'conditional' reviewers run when file_patterns match the diff (and optionally content_pattern exceeds threshold).",
  "judge_calibration": {
    "enabled": false,
    "description": "When enabled, scripts/calibrate_reviewers.py samples recent reviewer findings, asks the user (or a labeled corpus) to mark each pass/fail, and computes agreement = (judge_verdict == human_verdict) / n. Reviewers below the min_agreement threshold are flagged for review or demotion. Reviewers without a calibration block use the fallback threshold.",
    "fallback_min_agreement": 0.7,
    "fallback_sample_size": 20,
    "refresh_interval_days": 30
  },
  "reviewers": [
    {
      "id": "coderabbit",
      "tier": "always",
      "cascade_tier": 1,
      "subagent_type": "coderabbit:code-reviewer",
      "model": "sonnet",
      "description": "Consolidated first-pass: bugs, logic errors, conventions, patterns, plan adherence"
    },
    {
      "id": "silent-failure-hunter",
      "tier": "always",
      "cascade_tier": 2,
      "subagent_type": "pr-review-toolkit:silent-failure-hunter",
      "model": "sonnet",
      "description": "Swallowed errors, empty catches, hidden failures",
      "calibration": {
        "verdict_type": "binary",
        "min_agreement": 0.75,
        "sample_size": 20,
        "last_calibrated": null,
        "last_agreement": null
      }
    },
    {
      "id": "security-reviewer",
      "tier": "always",
      "cascade_tier": 2,
      "subagent_type": "security-reviewer",
      "model": "sonnet",
      "description": "Auth, data exposure, injection, OWASP",
      "calibration": {
        "verdict_type": "binary",
        "min_agreement": 0.8,
        "sample_size": 25,
        "last_calibrated": null,
        "last_agreement": null,
        "note": "Security findings have higher cost-of-miss — stricter agreement floor"
      }
    },
    {
      "id": "test-coverage-analyzer",
      "tier": "always",
      "cascade_tier": 2,
      "subagent_type": "pr-review-toolkit:pr-test-analyzer",
      "model": "sonnet",
      "description": "Test coverage gaps, missing edge cases, untested error paths"
    },
    {
      "id": "production-readiness-check",
      "tier": "always",
      "cascade_tier": 2,
      "subagent_type": "production-readiness-check",
      "model": "sonnet",
      "description": "27-point pre-ship checklist — SECURITY, DATABASE, DEPLOYMENT, CODE. Advisory mode; infra-confirm items prompt the user."
    },
    {
      "id": "curmudgeon-review",
      "tier": "always",
      "cascade_tier": 2,
      "runner": "codex-cli",
      "runner_script": "scripts/curmudgeon_review.sh",
      "model": "gpt-5-codex",
      "description": "Non-Anthropic second opinion — code smells, wrong abstractions, lazy tests"
    },
    {
      "id": "adversarial-breaker",
      "tier": "always",
      "cascade_tier": 2,
      "subagent_type": "general-purpose",
      "model": "sonnet",
      "description": "Adversarial evaluator — scores diff 1-10 on 6 break-criteria. Sub-threshold scores become blocking findings that feed Phase 5 retries.",
      "persona_file": "claude-flow/scripts/adversarial_breaker_persona.txt",
      "persona_file_root": "~/.claude/skills",
      "score_threshold": 7,
      "scored_criteria": [
        "input_validation",
        "error_handling",
        "concurrency_safety",
        "data_consistency",
        "failure_modes",
        "test_coverage_gaps"
      ],
      "calibration": {
        "verdict_type": "scored",
        "min_agreement": 0.7,
        "sample_size": 20,
        "last_calibrated": null,
        "last_agreement": null,
        "note": "Scored reviewer — agreement = (|judge_score - human_score| <= 2) / n"
      }
    },
    {
      "id": "migration-reviewer",
      "tier": "conditional",
      "cascade_tier": 3,
      "file_patterns": ["alembic/**/*.py", "**/migrations/**/*.py", "**/*.sql"],
      "subagent_type": "migration-reviewer",
      "model": "sonnet",
      "description": "Alembic migration safety checks"
    },
    {
      "id": "google-api-reviewer",
      "tier": "conditional",
      "cascade_tier": 3,
      "file_patterns": ["**/google/**", "**/calendar/**"],
      "content_pattern": "google|calendar_service|GoogleCredentials",
      "threshold": 2,
      "subagent_type": "google-api-reviewer",
      "model": "sonnet",
      "description": "Google API quota, auth, and best practices"
    },
    {
      "id": "async-reviewer",
      "tier": "conditional",
      "cascade_tier": 3,
      "file_patterns": ["**/*.py"],
      "content_pattern": "async def|await ",
      "threshold": 3,
      "subagent_type": "async-reviewer",
      "model": "sonnet",
      "description": "Blocking calls and async anti-patterns"
    },
    {
      "id": "type-design-analyzer",
      "tier": "conditional",
      "cascade_tier": 3,
      "file_patterns": ["**/models/**", "**/schemas/**", "**/types/**"],
      "subagent_type": "pr-review-toolkit:type-design-analyzer",
      "model": "haiku",
      "description": "Type/model/schema design quality"
    },
    {
      "id": "api-doc-auditor",
      "tier": "conditional",
      "cascade_tier": 3,
      "file_patterns": ["**/routes/**", "**/api/**", "**/endpoints/**"],
      "subagent_type": "api-doc-auditor",
      "model": "haiku",
      "description": "API documentation and schema consistency"
    },
    {
      "id": "invariant-checker",
      "tier": "conditional",
      "cascade_tier": 4,
      "file_patterns": ["**/models/**", "**/services/**", "**/routes/**"],
      "subagent_type": "courierflow-invariant-checker",
      "model": "haiku",
      "dynamic_prompt": true,
      "description": "Client sync, column names, query safety, eager loading (CF projects)"
    },
    {
      "id": "defensive-verifier",
      "tier": "conditional",
      "cascade_tier": 4,
      "file_patterns": ["**/templates/**", "**/static/**", "**/routes/**", "**/services/**"],
      "subagent_type": "defensive-pattern-verifier",
      "model": "haiku",
      "dynamic_prompt": true,
      "description": "Guard clauses, error handling, UI state management"
    }
  ]
}
