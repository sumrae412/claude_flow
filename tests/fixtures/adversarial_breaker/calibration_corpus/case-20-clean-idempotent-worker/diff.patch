@@ -1,3 +1,28 @@
+def process_webhook(event_id: str, payload: dict):
+    """Idempotent webhook processor with locking and error persistence."""
+    claimed = db.execute(
+        text("INSERT INTO webhook_events (event_id, status) VALUES (:id, 'claimed') "
+             "ON CONFLICT DO NOTHING RETURNING event_id"),
+        {"id": event_id},
+    ).first()
+
+    if not claimed:
+        log.info("webhook_already_processed", event_id=event_id)
+        return
+
+    try:
+        result = handle_payload(payload)
+        db.execute(
+            text("UPDATE webhook_events SET status = 'completed', result = :r WHERE event_id = :id"),
+            {"r": json.dumps(result), "id": event_id},
+        )
+        db.commit()
+    except Exception as e:
+        db.rollback()
+        db.execute(
+            text("UPDATE webhook_events SET status = 'failed', error = :e WHERE event_id = :id"),
+            {"e": str(e), "id": event_id},
+        )
+        db.commit()
+        raise
