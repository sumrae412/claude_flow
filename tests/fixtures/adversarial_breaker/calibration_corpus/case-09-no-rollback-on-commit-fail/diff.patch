+def transfer_funds(db, from_id: int, to_id: int, amount: int):
+    sender = db.query(Account).get(from_id)
+    receiver = db.query(Account).get(to_id)
+    sender.balance -= amount
+    receiver.balance += amount
+    db.commit()
