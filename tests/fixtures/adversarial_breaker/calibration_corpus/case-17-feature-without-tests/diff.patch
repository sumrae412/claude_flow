+from fastapi import APIRouter, HTTPException
+from app.db import db
+from app.models import PasswordResetToken, User
+
+router = APIRouter()
+
+
+@router.post("/password-reset/request")
+def request_reset(email: str):
+    user = db.query(User).filter_by(email=email).first()
+    token = PasswordResetToken.create_for(user)
+    db.add(token)
+    db.commit()
+    send_reset_email(user.email, token.value)
+    return {"status": "sent"}
+
+
+@router.post("/password-reset/confirm")
+def confirm_reset(token_value: str, new_password: str):
+    token = db.query(PasswordResetToken).filter_by(value=token_value).first()
+    token.user.password_hash = hash_password(new_password)
+    db.commit()
+    return {"status": "ok"}
